{
  "name": "why-broke",
  "version": "1.5.0",
  "description": "Explains why a build that worked yesterday fails today by diffing your runtime, dependencies, configs and environment against a known-good baseline.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "why-broke": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "debugging",
    "build-failure",
    "root-cause",
    "dependency-drift",
    "environment",
    "lockfile",
    "regression",
    "ci",
    "cli"
  ],
  "author": "Aditya Kammati",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adi-gitX/why-this-broke.git"
  },
  "bugs": {
    "url": "https://github.com/Adi-gitX/why-this-broke/issues"
  },
  "homepage": "https://github.com/Adi-gitX/why-this-broke#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
